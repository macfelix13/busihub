# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project Settings → Database → Connection string (used only by migration/seed scripts, not the app runtime).
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ── Paystack ──────────────────────────────────────────────────────────────
# There is deliberately NO Paystack key here. Every shop connects its own
# Paystack account in Settings → Payments, so the money settles to them and
# Busihub never holds it. What the server needs is the key those secrets are
# encrypted under, which never goes near the database:
#   openssl rand -base64 32
# SERVER ONLY. Changing or losing it makes every stored Paystack secret
# undecryptable, and each shop has to paste its secret key in again.
PAYSTACK_KEY_ENCRYPTION_KEY=replace-with-32-random-bytes-base64

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Used to sign short-lived cashier PIN session tokens. Generate with:
#   openssl rand -base64 48
PIN_SESSION_SECRET=replace-with-a-long-random-value

# ── Support ───────────────────────────────────────────────────────────────
# Busihub's own support contact (not any tenant's) — shown on the
# suspended/closed-account screen. Optional: lib/env.ts falls back to
# today's real values below if these are unset, so the app works
# correctly without them. Set these (and redeploy) to change the
# displayed contact details later without a code change — e.g. once a
# real busihub.app mailbox exists, to replace the Gmail address below.
NEXT_PUBLIC_SUPPORT_EMAIL=macfelix13@gmail.com
NEXT_PUBLIC_SUPPORT_PHONE=+233543945668

# ── Environment ───────────────────────────────────────────────────────────
NODE_ENV=development