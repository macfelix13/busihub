# ── Supabase ──────────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# SERVER ONLY. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Project Settings → Database → Connection string (used only by migration/seed scripts, not the app runtime).
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# ── Paystack ──────────────────────────────────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks. SERVER ONLY.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Used to sign short-lived cashier PIN session tokens. Generate with:
#   openssl rand -base64 48
PIN_SESSION_SECRET=replace-with-a-long-random-value

# ── Environment ───────────────────────────────────────────────────────────
NODE_ENV=development
